# Farm ERP configuration template.
# Copy this file to ".env" and fill in real values. Never commit the real .env file.

APP_NAME="Farm ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/farm-erp/public
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE_CURRENCY=INR
APP_DATE_FORMAT=d-m-Y

# DB_CONNECTION: mysql (production / XAMPP) or sqlite (only used by the automated
# test suite in environments where a MySQL server is not available).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=farm_erp
DB_USERNAME=root
DB_PASSWORD=
# Only read when DB_CONNECTION=sqlite:
DB_SQLITE_PATH=storage/database.sqlite

# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

SESSION_NAME=farm_erp_session
SESSION_LIFETIME_MINUTES=120
# Set to true only when serving over HTTPS.
SESSION_SECURE_COOKIE=false

# Optional outbound integrations. The system must run correctly with all of
# these left blank -- every workflow that depends on them must degrade
# gracefully (queue the notification / mark it "not sent") rather than fail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

SMS_PROVIDER=
SMS_API_KEY=

# Login throttling
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
